# Local development environment
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
#
# All secrets live in GCP Secret Manager (project: core-db-475718).
# Run the following to print the staging DATABASE_URL:
#   gcloud secrets versions access latest --secret=COA_MENU_DATABASE_URL --project=core-db-475718
#
# For local use, replace the ?host=... socket path with the Cloud SQL Auth Proxy address.
# Start the proxy first:
#   cloud-sql-proxy coa-menu-demo:us-central1:coa-menu-planner --port 5433
#   (use 5433 if port 5432 is already taken by a local Postgres instance)

# Replace PASSWORD with the value from Secret Manager (everything between : and @)
DATABASE_URL=postgresql://coa-menu-planner-app:PASSWORD@localhost:5433/coa_menu_planner

# From Secret Manager: COA_MENU_LUCIA_SECRET
LUCIA_SECRET=

# From Secret Manager: COA_MENU_USDA_API_KEY
USDA_API_KEY=

# Your personal Anthropic API key (for local AI features — not required for migrations)
ANTHROPIC_API_KEY=

# Leave as-is for local dev
NODE_ENV=development
PORT=3000
