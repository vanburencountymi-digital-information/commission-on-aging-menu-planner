    "migrate:node6": "node db/migrate6.js",
    "migrate:node7": "node db/migrate7.js",
    "migrate:node8": "node db/migrate8.js",
    "migrate:node9": "node db/migrate9.js",
    "migrate:node10": "node db/migrate10.js",
