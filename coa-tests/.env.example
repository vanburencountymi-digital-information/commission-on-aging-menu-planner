# COA Menu Planner — Test Suite Environment
# Copy this file to .env (no edits needed — all values are pre-filled).
# These are the test accounts created by apps/api/db/seeds/002_users.js
# For LOCAL dev only, seed them with a shared password so these values match:
#   SEED_PASSWORD=changeme123 node db/seeds/002_users.js
# Never seed a shared/deployed environment that way — omit SEED_PASSWORD there to get
# random per-account passwords, then put those in your .env.

# API base URL — change to http://localhost:3000 if you changed PORT in apps/api/.env
API_URL=http://localhost:3001

# Test month used for menu planning tests (pick any future month with no existing menu)
TEST_MONTH=2027-06

# Test accounts (created by seed; all use the same dev password)
TEST_ADMIN_EMAIL=admin@sjccoa.org
TEST_ADMIN_PASSWORD=changeme123

TEST_NM_EMAIL=nutrition@sjccoa.org
TEST_NM_PASSWORD=changeme123

TEST_RD_EMAIL=dietitian@sjccoa.org
TEST_RD_PASSWORD=changeme123

TEST_KITCHEN_EMAIL=kitchen@sjccoa.org
TEST_KITCHEN_PASSWORD=changeme123
