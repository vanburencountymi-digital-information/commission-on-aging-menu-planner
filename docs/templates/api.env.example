# apps/api/.env.example
# Copy to .env and fill in the values. NEVER commit .env.
#
# Secrets live in GCP Secret Manager (project: YOUR_GCP_PROJECT_ID).
# To get the DB password:
#   gcloud secrets versions access latest --secret=SECRET_NAME --project=YOUR_GCP_PROJECT_ID
#
# Local dev uses the Cloud SQL Auth Proxy (start it first):
#   cloud-sql-proxy YOUR_GCP_PROJECT_ID:us-central1:YOUR_INSTANCE --port=5433

# Replace PASSWORD with the value from Secret Manager
DATABASE_URL=postgresql://DB_USER:PASSWORD@localhost:5433/DB_NAME

# Firebase Admin SDK
# In Cloud Run: auto-discovered from the attached service account. Leave blank.
# Locally: either set to a service account key path, OR rely on ADC
#   (gcloud auth application-default login) which works for most cases.
GOOGLE_APPLICATION_CREDENTIALS=

# Other secrets from Secret Manager — fill in for local dev
SOME_API_KEY=
ANTHROPIC_API_KEY=

# Leave as-is
NODE_ENV=development
PORT=3001
